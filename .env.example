# Required for all runs
ANTHROPIC_API_KEY=your-api-key-here

# Required for live smoke (Sprint 1A+)
CLAUDE_POWERPLANT_MODEL_ID=choose-a-documented-managed-agents-compatible-model

# Required for Sprint 2A self-hosted worker
# Generate via: Anthropic Console → Workspace → Environments → <your-env> → Generate environment key
ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-...
# Set after running: npm run sprint2a:provision (prints the environment ID)
ANTHROPIC_ENVIRONMENT_ID=env_...

# Optional
NODE_ENV=development
CLAUDE_POWERPLANT_MAX_TURNS=10
